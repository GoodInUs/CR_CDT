    rdfs:label "supports Recommendation"@en ;
    rdfs:domain cut:DecisionBase ;
    rdfs:range cut:DecisionRecommendation ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:supportsService a owl:ObjectProperty ;
    rdfs:label "supports Service"@en ;
    rdfs:domain cut:RigidDataLoad ;
    rdfs:range cut:UrbanService ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:umlOperation a owl:AnnotationProperty .

cut:umlStereotype a owl:AnnotationProperty .

cut:vulnerabilityScore a owl:DatatypeProperty ;
    rdfs:label "vulnerability Score"@en ;
    rdfs:domain cut:VulnerabilityProfile ;
    rdfs:range xsd:decimal .

cut:waterDeficit a owl:DatatypeProperty ;
    rdfs:label "water Deficit"@en ;
    rdfs:domain cut:Drought ;
    rdfs:range xsd:decimal .

cut:windSpeed a owl:DatatypeProperty ;
    rdfs:label "wind Speed"@en ;
    rdfs:domain cut:Storm ;
    rdfs:range xsd:decimal .

cut:AnalyticsModule a owl:NamedIndividual ;
    rdfs:label "Analytics"@en .

cut:BatteryStorage a owl:Class ;
    rdfs:label "Battery Storage"@en ;
    rdfs:subClassOf cut:FlexibleResource ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:BatteryStorage_DC_01 a cut:BatteryStorage .

cut:ColdSpell a owl:Class ;
    rdfs:label "Cold Spell"@en ;
    rdfs:subClassOf cut:WeatherHazard ;
    cut:module cut:EnvironmentalContextModule .

cut:DecisionActionable a cut:DecisionStatus ;
    rdfs:label "Decision actionable"@en .

cut:DecisionBase_City_01 a cut:DecisionBase ;
    cut:supportsRecommendation cut:Recommendation_Heatwave_01 .

cut:DecisionContext_Heatwave_01 a cut:DecisionContext ;
    rdfs:label "Heatwave decision context 01"@en ;
    cut:decisionUrgency "High" ;
    cut:decisionWindow "PT2H"^^xsd:duration ;
    cut:hasAffectedInfrastructure cut:DataCentre_East_01 ;
    cut:hasAffectedService cut:UrbanService_EmergencyResponse,
        cut:UrbanService_TrafficManagement ;
    cut:hasAvailableFlexibility cut:BatteryStorage_DC_01,
        cut:ComputeFlexibility_DC_01 ;
    cut:hasCandidateAction cut:Action_Defer_Elastic_Load_01,
        cut:Action_Dispatch_Battery_01 ;
    cut:hasDecisionEvidence cut:Evidence_DataCentreTelemetry_01,
        cut:Evidence_GridState_01,
        cut:Evidence_HeatForecast_01,
        cut:Evidence_ServiceDependency_01 ;
    cut:hasDecisionRisk cut:HighDecisionRisk ;
    cut:hasDecisionStatus cut:DecisionActionable ;
    cut:hasGridConstraint cut:GridConstraint_East_01 ;
    cut:hasRiskAssessment cut:ImpactForecast_Heatwave_01 .

cut:DistrictHeatingNetwork a owl:Class ;
    rdfs:label "District Heating Network"@en ;
    cut:module cut:PhysicalUrbanInfrastructureModule ;
    cut:umlOperation "receiveWasteHeat()" .

cut:ElectricityGrid_East a cut:ElectricityGrid ;
    cut:availableHeadroom 1.1 ;
    cut:experiencesGridConstraint cut:GridConstraint_East_01 ;
    cut:operatingState "Constrained" ;
    cut:reserveMargin 0.09 ;
    cut:suppliesElectricityTo cut:DataCentre_East_01 .

cut:Explanation_Heatwave_01 a cut:ExplanationAssurance ;
    cut:confidence 0.86 ;
    cut:explainsRecommendation cut:Recommendation_Heatwave_01 ;
    cut:provenance "Derived from heat forecast, data-centre telemetry, grid state and service dependency model" ;
    cut:supportedByEvidence cut:Evidence_DataCentreTelemetry_01,
        cut:Evidence_GridState_01,
        cut:Evidence_HeatForecast_01,
        cut:Evidence_ServiceDependency_01 .

cut:GridBrokering a owl:Class ;
    rdfs:label "Grid Brokering"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "dispatchBattery()",
        "dispatchVehicleToGrid()",
        "requestDemandResponse()" .

cut:HighDecisionRisk a cut:DecisionRisk ;
    rdfs:label "High decision risk"@en .

cut:KnowledgeBase_City_01 a cut:KnowledgeBase ;
    cut:providesModelTo cut:PredictionScenarioEngine_01 .

cut:MetOfficeDataHub a owl:Class ;
    rdfs:label "Met Office Data Hub"@en ;
    rdfs:subClassOf cut:EnvironmentalDataSource ;
    cut:module cut:EnvironmentalContextModule ;
    cut:umlOperation "getAtmosphericModel()",
        "getWeatherWarnings()" ;
    cut:umlStereotype "external API" .

cut:RigidDataLoad a owl:Class ;
    rdfs:label "Rigid Data Load"@en ;
    rdfs:subClassOf cut:DataCentreLoad ;
    cut:module cut:PhysicalUrbanInfrastructureModule .

cut:SensorNetwork a owl:Class ;
    rdfs:label "Sensor Network"@en ;
    rdfs:subClassOf cut:EnvironmentalDataSource ;
    cut:module cut:EnvironmentalContextModule ;
    cut:umlOperation "getObservation()" ;
    cut:umlStereotype "SOSA/SSN" .

cut:UrbanService_EmergencyResponse a cut:UrbanService ;
    cut:dependsOn cut:DataCentre_East_01 ;
    cut:hasServiceImpactTarget cut:ImpactForecast_Heatwave_01 ;
    cut:minimumServiceLevel 0.95 ;
    cut:serviceId "SERVICE-EMERGENCY-01" .

cut:WaterSupply a owl:Class ;
    rdfs:label "Water Supply"@en ;
    cut:module cut:PhysicalUrbanInfrastructureModule .

cut:WorkloadManagement a owl:Class ;
    rdfs:label "Workload Management"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "deferElasticLoad()",
        "migrateWorkload()",
        "throttleComputeLoad()" .

cut:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends On"@en ;
    rdfs:domain cut:UrbanService ;
    rdfs:range cut:DataCentre ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:hasDecisionBase a owl:ObjectProperty ;
    rdfs:label "has Decision Base"@en ;
    rdfs:domain cut:CognitiveTwin ;
    rdfs:range cut:DecisionBase ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:hasDecisionContext a owl:ObjectProperty ;
    rdfs:label "has decision context"@en ;
    rdfs:domain cut:CognitiveTwin ;
    rdfs:range cut:DecisionContext ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:hasDecisionEvidence a owl:ObjectProperty ;
    rdfs:label "has decision evidence"@en ;
    rdfs:domain cut:DecisionContext ;
    rdfs:range cut:DecisionEvidence ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:hasKnowledgeBase a owl:ObjectProperty ;
    rdfs:label "has Knowledge Base"@en ;
    rdfs:domain cut:CognitiveTwin ;
    rdfs:range cut:KnowledgeBase ;
    rdfs:subPropertyOf cut:hasSemanticRelationship .

cut:hasObservationBase a owl:ObjectProperty ;
    rdfs:label "has Observation Base"@en ;
    rdfs:domain cut:CognitiveTwin ;
    rdfs:range cut:ObservationBase ;
    rdfs:subPropertyOf cut:hasAnalyticRelationship .

cut:recommendsAction a owl:ObjectProperty ;
    rdfs:label "recommends Action"@en ;
    rdfs:domain cut:DecisionRecommendation ;
    rdfs:range cut:AnticipatoryAction ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:suppliesElectricityTo a owl:ObjectProperty ;
    rdfs:label "supplies Electricity To"@en ;
    rdfs:domain cut:ElectricityGrid ;
    rdfs:range cut:DataCentre ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:threatens a owl:ObjectProperty ;
    rdfs:label "threatens"@en ;
    rdfs:domain cut:WeatherHazard ;
    rdfs:range cut:DataCentre ;
    rdfs:subPropertyOf cut:hasRiskRelationship .

cut:CognitiveTwin_City_01 a cut:CognitiveTwin ;
    cut:generatesRecommendation cut:Recommendation_Heatwave_01 ;
    cut:hasDecisionBase cut:DecisionBase_City_01 ;
    cut:hasDecisionContext cut:DecisionContext_Heatwave_01 ;
    cut:hasKnowledgeBase cut:KnowledgeBase_City_01 ;
    cut:hasObservationBase cut:ObservationBase_City_01 .

cut:ComputeFlexibility a owl:Class ;
    rdfs:label "Compute Flexibility"@en ;
    rdfs:subClassOf cut:FlexibleResource ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:ComputeFlexibility_DC_01 a cut:ComputeFlexibility .

cut:CoolingSystem a owl:Class ;
    rdfs:label "Cooling System"@en ;
    cut:module cut:PhysicalUrbanInfrastructureModule .

cut:Drought a owl:Class ;
    rdfs:label "Drought"@en ;
    rdfs:subClassOf cut:WeatherHazard ;
    cut:module cut:EnvironmentalContextModule .

cut:ElasticDataLoad a owl:Class ;
    rdfs:label "Elastic Data Load"@en ;
    rdfs:subClassOf cut:DataCentreLoad ;
    cut:module cut:PhysicalUrbanInfrastructureModule ;
    cut:umlOperation "defer()",
        "throttle()" .

cut:EnvironmentalDataSource a owl:Class ;
    rdfs:label "Environmental Data Source"@en ;
    cut:module cut:EnvironmentalContextModule ;
    cut:umlOperation "getForecasts()",
        "getObservations()" ;
    cut:umlStereotype "interface" .

cut:Evidence_DataCentreTelemetry_01 a cut:DecisionEvidence ;
    rdfs:label "Data-centre telemetry evidence"@en ;
    cut:evidenceAbout cut:DataCentre_East_01 ;
    cut:evidenceConfidence 0.95 ;
    cut:evidenceType "Infrastructure telemetry" .

cut:Evidence_GridState_01 a cut:DecisionEvidence ;
    rdfs:label "Grid-state evidence"@en ;
    cut:evidenceAbout cut:ElectricityGrid_East ;
    cut:evidenceConfidence 0.90 ;
    cut:evidenceType "Grid state" .

cut:Evidence_HeatForecast_01 a cut:DecisionEvidence ;
    rdfs:label "Heat forecast evidence"@en ;
    cut:evidenceAbout cut:Heatwave_August_01 ;
    cut:evidenceConfidence 0.92 ;
    cut:evidenceType "Weather forecast" .

cut:Evidence_ServiceDependency_01 a cut:DecisionEvidence ;
    rdfs:label "Service-dependency evidence"@en ;
    cut:evidenceAbout cut:UrbanService_TrafficManagement ;
    cut:evidenceConfidence 0.99 ;
    cut:evidenceType "Service dependency" .

cut:ExtremeHeat a owl:Class ;
    rdfs:label "Extreme Heat"@en ;
    rdfs:subClassOf cut:WeatherHazard ;
    cut:module cut:EnvironmentalContextModule .

cut:Flood a owl:Class ;
    rdfs:label "Flood"@en ;
    rdfs:subClassOf cut:WeatherHazard ;
    cut:module cut:EnvironmentalContextModule .

cut:Heatwave_August_01 a cut:ExtremeHeat ;
    cut:expectedDuration "P2D"^^xsd:duration ;
    cut:expectedOnset "2026-08-24T10:00:00"^^xsd:dateTime ;
    cut:hazardType "Extreme heat" ;
    cut:maximumTemperature 38.5 ;
    cut:severityLevel "High" ;
    cut:threatens cut:DataCentre_East_01 .

cut:PredictionScenarioEngine_01 a cut:PredictionScenarioEngine ;
    cut:feedsScenarioTo cut:CognitiveTwin_City_01 ;
    cut:producesImpactForecast cut:ImpactForecast_Heatwave_01 .

cut:Storm a owl:Class ;
    rdfs:label "Storm"@en ;
    rdfs:subClassOf cut:WeatherHazard ;
    cut:module cut:EnvironmentalContextModule .

cut:UrbanInfrastructure a owl:Class ;
    rdfs:label "Urban Infrastructure"@en ;
    cut:module cut:PhysicalUrbanInfrastructureModule ;
    cut:umlStereotype "CityGML 3.0" .

cut:UrbanService_TrafficManagement a cut:UrbanService ;
    cut:dependsOn cut:DataCentre_East_01 ;
    cut:hasServiceImpactTarget cut:ImpactForecast_Heatwave_01 ;
    cut:minimumServiceLevel 0.85 ;
    cut:serviceId "SERVICE-TRAFFIC-01" .

cut:WasteHeat a owl:Class ;
    rdfs:label "Waste Heat"@en ;
    cut:module cut:PhysicalUrbanInfrastructureModule .

cut:justifiedBy a owl:ObjectProperty ;
    rdfs:label "justified By"@en ;
    rdfs:domain cut:DecisionRecommendation ;
    rdfs:range cut:ExplanationAssurance ;
    rdfs:subPropertyOf cut:hasDecisionRelationship .

cut:Action_Defer_Elastic_Load_01 a cut:CandidateAction,
        cut:WorkloadManagement ;
    cut:actionId "ACT-WORKLOAD-001" ;
    cut:requiredLeadTime "PT30M"^^xsd:duration ;
    cut:returnsOutcomeDataTo cut:ObservationBase_City_01 .

cut:Action_Dispatch_Battery_01 a cut:CandidateAction,
        cut:GridBrokering ;
    cut:actionId "ACT-GRID-001" ;
    cut:requiredLeadTime "PT10M"^^xsd:duration ;
    cut:returnsOutcomeDataTo cut:ObservationBase_City_01 .

cut:CandidateAction a owl:Class ;
    rdfs:label "Candidate Action"@en ;
    rdfs:subClassOf cut:AnticipatoryAction .

cut:DataCentreLoad a owl:Class ;
    rdfs:label "Data Centre Load"@en ;
    cut:isAbstract true ;
    cut:module cut:PhysicalUrbanInfrastructureModule .

cut:ExposureProfile a owl:Class ;
    rdfs:label "Exposure Profile"@en ;
    cut:module cut:ImpactandRiskAssessmentModule .

cut:GridConstraint_East_01 a cut:GridConstraint ;
    cut:capacityLimit 8.8 ;
    cut:outageProbability 0.12 ;
    cut:voltageLimit 1.00 .

cut:ImpactandRiskAssessmentModule a owl:NamedIndividual ;
    rdfs:label "Impact and Risk Assessment"@en .

cut:ObservationBase_City_01 a cut:ObservationBase ;
    cut:providesStateTo cut:PredictionScenarioEngine_01 .

cut:Recommendation_Heatwave_01 a cut:DecisionRecommendation ;
    cut:confidence 0.86 ;
    cut:decisionDeadline "2026-08-24T08:00:00"^^xsd:dateTime ;
    cut:justifiedBy cut:Explanation_Heatwave_01 ;
    cut:rationale "Reduce flexible compute demand before peak heat and grid stress while preserving critical urban services." ;
    cut:recommendationId "REC-HEAT-001" ;
    cut:recommendsAction cut:Action_Defer_Elastic_Load_01,
        cut:Action_Dispatch_Battery_01 ;
    cut:selectedAction cut:Action_Defer_Elastic_Load_01,
        cut:Action_Dispatch_Battery_01 .

cut:UrbanServiceFeedbackAction a owl:Class ;
    rdfs:label "Urban Service Feedback Action"@en ;
    rdfs:subClassOf cut:AnticipatoryAction ;
    cut:isAbstract true ;
    cut:module cut:FeedbackandAdaptationActionsModule .

cut:VulnerabilityProfile a owl:Class ;
    rdfs:label "Vulnerability Profile"@en ;
    cut:module cut:ImpactandRiskAssessmentModule .

cut:CapabilityState a owl:Class ;
    rdfs:label "Capability State"@en ;
    cut:module cut:UrbanServicesModule ;
    cut:umlStereotype "enumeration" .

cut:CriticalityLevel a owl:Class ;
    rdfs:label "Criticality Level"@en ;
    cut:module cut:UrbanServicesModule ;
    cut:umlStereotype "enumeration" .

cut:DecisionBase a owl:Class ;
    rdfs:label "Decision Base"@en ;
    cut:module cut:CognitiveTwinModule ;
    cut:umlOperation "recordDecision()",
        "selectAction()" ;
    cut:umlStereotype "policy and action store" .

cut:FlexibleResource a owl:Class ;
    rdfs:label "Flexible Resource"@en ;
    cut:isAbstract true ;
    cut:module cut:EnergyandFlexibilitySystemModule ;
    cut:umlOperation "activate()" .

cut:GridConstraint a owl:Class ;
    rdfs:label "Grid Constraint"@en ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:ImpactForecast_Heatwave_01 a cut:ImpactForecast ;
    cut:confidence 0.86 ;
    cut:expectedSocioEconomicCost 1250000.0 ;
    cut:hasHazardInput cut:Heatwave_August_01 ;
    cut:impactLevel "High" ;
    cut:providesRiskContextTo cut:CognitiveTwin_City_01 .

cut:KnowledgeBase a owl:Class ;
    rdfs:label "Knowledge Base"@en ;
    cut:module cut:CognitiveTwinModule ;
    cut:umlOperation "getDependencyGraph()",
        "inferDependencies()",
        "validateSemanticConsistency()" ;
    cut:umlStereotype "ontology and knowledge graph" .

cut:UrbanServicesModule a owl:NamedIndividual ;
    rdfs:label "Urban Services"@en .

cut:DataCentreFeedbackAction a owl:Class ;
    rdfs:label "Data Centre Feedback Action"@en ;
    rdfs:subClassOf cut:AnticipatoryAction ;
    cut:isAbstract true ;
    cut:module cut:FeedbackandAdaptationActionsModule .

cut:DecisionStatus a owl:Class ;
    rdfs:label "Decision Status"@en .

cut:ObservationBase a owl:Class ;
    rdfs:label "Observation Base"@en ;
    cut:module cut:CognitiveTwinModule ;
    cut:umlOperation "getCurrentState()",
        "getHistoricalState()",
        "storeObservation()" ;
    cut:umlStereotype "integrated state store" .

cut:PredictionScenarioEngine a owl:Class ;
    rdfs:label "Prediction Scenario Engine"@en ;
    cut:module cut:AnalyticsModule ;
    cut:umlOperation "forecastServiceRisk()",
        "forecastWeatherImpact()",
        "generateScenarios()",
        "modelPropagation()" ;
    cut:umlStereotype "analytics" .

cut:CognitiveTwinModule a owl:NamedIndividual ;
    rdfs:label "Cognitive Twin"@en .

cut:DataCentre_East_01 a cut:DataCentre ;
    cut:contributesDemandTo cut:GridConstraint_East_01 ;
    cut:dataCentreId "DC-EAST-01" ;
    cut:hazardExposure "Heat stress" ;
    cut:maximumPowerDemand 9.5 ;
    cut:powerUsageEffectiveness 1.42 .

cut:DecisionRisk a owl:Class ;
    rdfs:label "Decision Risk"@en .

cut:ElectricityGrid a owl:Class ;
    rdfs:label "Electricity Grid"@en ;
    cut:module cut:EnergyandFlexibilitySystemModule ;
    cut:umlOperation "getGridState()" ;
    cut:umlStereotype "UKPN Open Data" .

cut:ExplanationAssurance a owl:Class ;
    rdfs:label "Explanation Assurance"@en ;
    cut:module cut:CognitiveTwinModule ;
    cut:umlOperation "traceEvidence()" ;
    cut:umlStereotype "assurance" .

cut:EnergyandFlexibilitySystemModule a owl:NamedIndividual ;
    rdfs:label "Energy and Flexibility System"@en .

cut:ServiceType a owl:Class ;
    rdfs:label "Service Type"@en ;
    cut:module cut:UrbanServicesModule ;
    cut:umlStereotype "enumeration" .

cut:CognitiveTwin a owl:Class ;
    rdfs:label "Cognitive Twin"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cut:ObservationBase ;
            owl:onProperty cut:hasObservationBase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cut:KnowledgeBase ;
            owl:onProperty cut:hasKnowledgeBase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cut:DecisionBase ;
            owl:onProperty cut:hasDecisionBase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    cut:module cut:CognitiveTwinModule ;
    cut:umlOperation "explainRecommendation()",
        "optimiseResourceAllocation()",
        "reasonOverState()" ;
    cut:umlStereotype "decision-support system" .

cut:UrbanService a owl:Class ;
    rdfs:label "Urban Service"@en ;
    cut:module cut:UrbanServicesModule .

cut:AnticipatoryAction a owl:Class ;
    rdfs:label "Anticipatory Action"@en ;
    cut:isAbstract true ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "evaluateOutcome()",
        "execute()" .

cut:DecisionEvidence a owl:Class ;
    rdfs:label "Decision Evidence"@en .

cut:EnvironmentalContextModule a owl:NamedIndividual ;
    rdfs:label "Environmental Context"@en .

cut:ImpactForecast a owl:Class ;
    rdfs:label "Impact Forecast"@en ;
    cut:module cut:ImpactandRiskAssessmentModule ;
    cut:umlOperation "calculateImpact()" ;
    cut:umlStereotype "assessment" .

cut:PhysicalUrbanInfrastructureModule a owl:NamedIndividual ;
    rdfs:label "Physical Urban Infrastructure"@en .

cut:DecisionRecommendation a owl:Class ;
    rdfs:label "Decision Recommendation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass cut:ExplanationAssurance ;
            owl:onProperty cut:justifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cut:AnticipatoryAction ;
            owl:onProperty cut:recommendsAction ] ;
    cut:module cut:CognitiveTwinModule .

cut:FeedbackandAdaptationActionsModule a owl:NamedIndividual ;
    rdfs:label "Feedback and Adaptation Actions"@en .

cut:DecisionContext a owl:Class ;
    rdfs:label "Decision Context"@en .

cut:WeatherHazard a owl:Class ;
    rdfs:label "Weather Hazard"@en ;
    cut:isAbstract true ;
    cut:module cut:EnvironmentalContextModule .

cut:DataCentre a owl:Class ;
    rdfs:label "Data Centre"@en ;
    rdfs:subClassOf cut:UrbanInfrastructure ;
    cut:module cut:PhysicalUrbanInfrastructureModule ;
    cut:umlOperation "getTelemetry()" ;
    cut:umlStereotype "Brick Schema" .

