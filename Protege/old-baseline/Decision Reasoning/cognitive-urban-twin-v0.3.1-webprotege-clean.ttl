@prefix cut: <https://example.org/cognitive-urban-twin#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/cognitive-urban-twin> a owl:Ontology ;
    rdfs:label "Cognitive Urban Twin Ontology"@en ;
    rdfs:comment """
Property hierarchy introduced in v0.2:
- structural relationships
- dependency relationships
- risk relationships
- observation relationships
- semantic relationships
- analytic relationships
- decision relationships

The hierarchy is intended to improve navigation, reasoning clarity and future
SHACL/competency-question development while preserving traceability to the
Figure 4.4 UML model.
"""@en,
        "Protégé starter ontology derived from the Cognitive Urban Twin conceptual UML model."@en,
        "v0.2 introduces an engineered object-property hierarchy while preserving the v0.1 UML-to-OWL baseline semantics."@en,
        "v0.3 introduces an explicit DecisionContext and decision-evidence layer for explainable, action-oriented reasoning over the heatwave scenario."@en,
        "v0.3.1 is the WebProtégé-clean release. Anonymous OWL cardinality restrictions on DecisionContext were removed from the class hierarchy and transferred to SHACL validation constraints."@en ;
    owl:versionInfo "0.3.1" .

cut:CarbonIntensityService a owl:Class ;
    rdfs:label "Carbon Intensity Service"@en ;
    cut:module cut:EnergyandFlexibilitySystemModule ;
    cut:umlOperation "getCarbonForecast()" ;
    cut:umlStereotype "NESO external API" .

cut:CivicEmergencyResponse a owl:Class ;
    rdfs:label "Civic Emergency Response"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "openEmergencyFacilities()",
        "preDeployFloodBarriers()",
        "publishHazardWarning()" .

cut:Communications a cut:ServiceType .

cut:CoolingWaterManagement a owl:Class ;
    rdfs:label "Cooling Water Management"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "limitEvaporativeUse()",
        "switchToDryCooling()" .

cut:Critical a cut:CriticalityLevel .

cut:DecisionExecuted a cut:DecisionStatus ;
    rdfs:label "Decision executed"@en .

cut:DecisionPending a cut:DecisionStatus ;
    rdfs:label "Decision pending"@en .

cut:Degraded a cut:CapabilityState .

cut:DistrictHeatingControl a owl:Class ;
    rdfs:label "District Heating Control"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "allocateWasteHeat()" .

cut:ElasticLoad_AI_01 a cut:ElasticDataLoad ;
    cut:providesComputeFlexibility cut:ComputeFlexibility_DC_01 .

cut:ElectricVehicleFleet a owl:Class ;
    rdfs:label "Electric Vehicle Fleet"@en ;
    rdfs:subClassOf cut:FlexibleResource ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:EmergencyResponse a cut:ServiceType .

cut:EnergyManagement a cut:ServiceType .

cut:Failed a cut:CapabilityState .

cut:HealthcareServices a cut:ServiceType .

cut:High a cut:CriticalityLevel .

cut:Low a cut:CriticalityLevel .

cut:LowDecisionRisk a cut:DecisionRisk ;
    rdfs:label "Low decision risk"@en .

cut:Medium a cut:CriticalityLevel .

cut:MediumDecisionRisk a cut:DecisionRisk ;
    rdfs:label "Medium decision risk"@en .

cut:Normal a cut:CapabilityState .

cut:OtherCritical a cut:ServiceType .

cut:PublicSafety a cut:ServiceType .

cut:Recovering a cut:CapabilityState .

cut:RecoveryPlanning a owl:Class ;
    rdfs:label "Recovery Planning"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "planRampUp()",
        "sequenceRestoration()" .

cut:ServiceModeControl a owl:Class ;
    rdfs:label "Service Mode Control"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "degradeGracefully()",
        "restoreService()" .

cut:SocioEconomicResponse a owl:Class ;
    rdfs:label "Socio Economic Response"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "distributeCashTransfer()",
        "prioritiseVulnerableGroups()" .

cut:TrafficManagement a cut:ServiceType .

