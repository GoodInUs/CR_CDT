    rdfs:range xsd:integer .

cut:isAbstract a owl:AnnotationProperty .

cut:isDependedOnBy a owl:ObjectProperty ;
    rdfs:label "is depended on by"@en ;
    rdfs:subPropertyOf cut:hasDependencyRelationship ;
    owl:inverseOf cut:dependsOn .

cut:isJustificationFor a owl:ObjectProperty ;
    rdfs:label "is justification for"@en ;
    rdfs:subPropertyOf cut:hasDecisionRelationship ;
    owl:inverseOf cut:justifiedBy .

cut:isSuppliedElectricityBy a owl:ObjectProperty ;
    rdfs:label "is supplied electricity by"@en ;
    rdfs:subPropertyOf cut:hasDependencyRelationship ;
    owl:inverseOf cut:suppliesElectricityTo .

cut:isThreatenedBy a owl:ObjectProperty ;
    rdfs:label "is threatened by"@en ;
    rdfs:subPropertyOf cut:hasRiskRelationship ;
    owl:inverseOf cut:threatens .

cut:maximumPowerDemand a owl:DatatypeProperty ;
    rdfs:label "maximum Power Demand"@en ;
    rdfs:domain cut:DataCentre ;
    rdfs:range xsd:decimal .

cut:maximumTemperature a owl:DatatypeProperty ;
    rdfs:label "maximum Temperature"@en ;
    rdfs:domain cut:ExtremeHeat ;
    rdfs:range xsd:decimal .

cut:minimumServiceLevel a owl:DatatypeProperty ;
    rdfs:label "minimum Service Level"@en ;
