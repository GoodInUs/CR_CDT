@prefix cut: <https://example.org/cognitive-urban-twin#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/cognitive-urban-twin> a owl:Ontology ;
    rdfs:label "Cognitive Urban Twin Ontology"@en ;
    rdfs:comment """
Property hierarchy introduced in v0.2:
- structural relationships
- dependency relationships
- risk relationships
- observation relationships
- semantic relationships
- analytic relationships
- decision relationships

The hierarchy is intended to improve navigation, reasoning clarity and future
SHACL/competency-question development while preserving traceability to the
Figure 4.4 UML model.
"""@en,
        "Protégé starter ontology derived from the Cognitive Urban Twin conceptual UML model."@en,
        "v0.2 introduces an engineered object-property hierarchy while preserving the v0.1 UML-to-OWL baseline semantics."@en ;
    owl:versionInfo "0.2.0" .

cut:BatteryStorage a owl:Class ;
    rdfs:label "Battery Storage"@en ;
    rdfs:subClassOf cut:FlexibleResource ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:CarbonIntensityService a owl:Class ;
    rdfs:label "Carbon Intensity Service"@en ;
    cut:module cut:EnergyandFlexibilitySystemModule ;
    cut:umlOperation "getCarbonForecast()" ;
    cut:umlStereotype "NESO external API" .

cut:CivicEmergencyResponse a owl:Class ;
    rdfs:label "Civic Emergency Response"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "openEmergencyFacilities()",
        "preDeployFloodBarriers()",
        "publishHazardWarning()" .

cut:Communications a cut:ServiceType .

cut:CoolingWaterManagement a owl:Class ;
    rdfs:label "Cooling Water Management"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "limitEvaporativeUse()",
        "switchToDryCooling()" .

cut:Critical a cut:CriticalityLevel .

cut:Degraded a cut:CapabilityState .

cut:DistrictHeatingControl a owl:Class ;
    rdfs:label "District Heating Control"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "allocateWasteHeat()" .

cut:ElectricVehicleFleet a owl:Class ;
    rdfs:label "Electric Vehicle Fleet"@en ;
    rdfs:subClassOf cut:FlexibleResource ;
    cut:module cut:EnergyandFlexibilitySystemModule .

cut:EmergencyResponse a cut:ServiceType .

cut:EnergyManagement a cut:ServiceType .

cut:Failed a cut:CapabilityState .

cut:GridBrokering a owl:Class ;
    rdfs:label "Grid Brokering"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "dispatchBattery()",
        "dispatchVehicleToGrid()",
        "requestDemandResponse()" .

cut:HealthcareServices a cut:ServiceType .

cut:High a cut:CriticalityLevel .

cut:Low a cut:CriticalityLevel .

cut:Medium a cut:CriticalityLevel .

cut:Normal a cut:CapabilityState .

cut:OtherCritical a cut:ServiceType .

cut:PublicSafety a cut:ServiceType .

cut:Recovering a cut:CapabilityState .

cut:RecoveryPlanning a owl:Class ;
    rdfs:label "Recovery Planning"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "planRampUp()",
        "sequenceRestoration()" .

cut:ServiceModeControl a owl:Class ;
    rdfs:label "Service Mode Control"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "degradeGracefully()",
        "restoreService()" .

cut:SocioEconomicResponse a owl:Class ;
    rdfs:label "Socio Economic Response"@en ;
    rdfs:subClassOf cut:UrbanServiceFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "distributeCashTransfer()",
        "prioritiseVulnerableGroups()" .

cut:TrafficManagement a cut:ServiceType .

cut:WorkloadManagement a owl:Class ;
    rdfs:label "Workload Management"@en ;
    rdfs:subClassOf cut:DataCentreFeedbackAction ;
    cut:module cut:FeedbackandAdaptationActionsModule ;
    cut:umlOperation "deferElasticLoad()",
        "migrateWorkload()",
        "throttleComputeLoad()" .

cut:actionId a owl:DatatypeProperty ;
    rdfs:label "action Id"@en ;
    rdfs:domain cut:AnticipatoryAction ;
    rdfs:range xsd:string .

cut:assetsInHazardZone a owl:DatatypeProperty ;
    rdfs:label "assets In Hazard Zone"@en ;
    rdfs:domain cut:ExposureProfile ;
    rdfs:range xsd:integer .

cut:availableHeadroom a owl:DatatypeProperty ;
    rdfs:label "available Headroom"@en ;
    rdfs:domain cut:ElectricityGrid ;
    rdfs:range xsd:decimal .

cut:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:domain cut:ImpactForecast ;
    rdfs:range xsd:decimal .

cut:consumesWaterFrom a owl:ObjectProperty ;
    rdfs:label "consumes Water From"@en ;
    rdfs:domain cut:CoolingSystem ;
    rdfs:range cut:WaterSupply ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en ;
    rdfs:domain cut:UrbanInfrastructure ;
    rdfs:range cut:DataCentre ;
    rdfs:subPropertyOf cut:hasStructuralRelationship .

cut:contributesDemandTo a owl:ObjectProperty ;
    rdfs:label "contributes Demand To"@en ;
    rdfs:domain cut:DataCentre ;
    rdfs:range cut:GridConstraint ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:dataCentreId a owl:DatatypeProperty ;
    rdfs:label "data Centre Id"@en ;
    rdfs:domain cut:DataCentre ;
    rdfs:range xsd:string .

cut:decisionDeadline a owl:DatatypeProperty ;
    rdfs:label "decision Deadline"@en ;
    rdfs:domain cut:DecisionRecommendation ;
    rdfs:range xsd:dateTime .

cut:dryPeriodDuration a owl:DatatypeProperty ;
    rdfs:label "dry Period Duration"@en ;
    rdfs:domain cut:Drought ;
    rdfs:range xsd:duration .

cut:expectedDuration a owl:DatatypeProperty ;
    rdfs:label "expected Duration"@en ;
    rdfs:domain cut:WeatherHazard ;
    rdfs:range xsd:duration .

cut:expectedOnset a owl:DatatypeProperty ;
    rdfs:label "expected Onset"@en ;
    rdfs:domain cut:WeatherHazard ;
    rdfs:range xsd:dateTime .

cut:expectedSocioEconomicCost a owl:DatatypeProperty ;
    rdfs:label "expected Socio Economic Cost"@en ;
    rdfs:domain cut:ImpactForecast ;
    rdfs:range xsd:decimal .

cut:experiencesGridConstraint a owl:ObjectProperty ;
    rdfs:label "experiences Grid Constraint"@en ;
    rdfs:domain cut:ElectricityGrid ;
    rdfs:range cut:GridConstraint ;
    rdfs:subPropertyOf cut:hasDependencyRelationship .

cut:exposedAssetValue a owl:DatatypeProperty ;
    rdfs:label "exposed Asset Value"@en ;
    rdfs:domain cut:ExposureProfile ;
    rdfs:range xsd:decimal .

cut:exposedPopulation a owl:DatatypeProperty ;
    rdfs:label "exposed Population"@en ;
    rdfs:domain cut:ExposureProfile ;
    rdfs:range xsd:integer .

cut:feedsScenarioTo a owl:ObjectProperty ;
    rdfs:label "feeds Scenario To"@en ;
    rdfs:domain cut:PredictionScenarioEngine ;
    rdfs:range cut:CognitiveTwin ;
    rdfs:subPropertyOf cut:hasAnalyticRelationship .

cut:floodZone a owl:DatatypeProperty ;
    rdfs:label "flood Zone"@en ;
