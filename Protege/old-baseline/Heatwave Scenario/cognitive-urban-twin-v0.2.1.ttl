    rdfs:subPropertyOf cut:hasObservationRelationship .

cut:rationale a owl:DatatypeProperty ;
    rdfs:label "rationale"@en ;
    rdfs:domain cut:DecisionRecommendation ;
    rdfs:range xsd:string .

cut:recommendationId a owl:DatatypeProperty ;
